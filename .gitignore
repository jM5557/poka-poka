# Build output
/out/
/build/
CMakeUserPresets.json

# Build directories created outside /out/ (per-stage trees use names like b457_perf)
b*_perf/
cmake-build-*/

# Binary build artifacts, wherever they land
*.exe
*.dll
*.lib
*.obj
*.exp
*.iobj
*.ipdb
*.res
*.tlog

# Copyrighted game data.  Never publish: the PSP executable, its decrypted ELF
# and save data are the user's own dumped media, not part of this source tree.
PSP_DATA/
SAVEDATA/
*.ELF
*.elf
*.iso
*.cso
EBOOT.BIN
DATA.BIN
PARAM.SFO
*.PBP
*.prx
*.ovl
overlay_*.bin

# Output the game produces when run: screenshots and audio dumps
*.bmp
*.wav

# User-owned game data and reverse-engineering workspace
/profiles/*/game/
/profiles/*/analysis/
/profiles/*/progress/
/profiles/*/captures/
# The MHP3rd AOT corpora are derived from the user's executable
/profiles/mhp3rd/generated/
/profiles/mhp3rd/overlays/
/profiles/pokapoka/generated/
/profiles/pokapoka/overlays/

# Local dumps next to the repository root
/dump/

# Extracted game text (the game's own strings; never committed)
/docs/TEXT_DUMP/

# Generated scratch output
*.generated
*.tmp
*.log
*.pdb
*.ilk

# Editor and agent tooling
.claude/

# Developer-local devices, addresses and test paths
/LOCAL_TESTING.md

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo

# Python
__pycache__/
*.pyc
.DS_Store

# Signing keys (the Android release key): never committed
/keys/

# Private device-testing configuration and release plans
/device-testing.local.json
/device-release.local.json

# Packages built from the player's own game (AppImage, APK): never committed
/dist/

# Packaging leftovers, wherever a script put them: built packages, their
# staging folders, downloaded packaging tools and signing keys
*.AppImage
*.AppImage.zsync
*.apk
*.aab
*.idsig
*.keystore
*.jks
AppDir/
*.AppDir/
squashfs-root/
appimagetool*
linuxdeploy*
.gradle/
local.properties

# Compiler output outside /out/ (the generated code's objects come from the game)
*.o
*.obj
*.a
*.so
*.so.*
*.ninja
.ninja_deps
.ninja_log
CMakeCache.txt
CMakeFiles/
compile_commands.json
/build-*/
/work/
/.work/

# Output of the font tools (tools/font_fit.py, tools/font_probe.py): built
# from the game's own fonts, never committed
font_fit_out/
probe_*/
*.pkdm
*.xdelta
*.unpacked
*.packed
